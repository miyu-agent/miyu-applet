{
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm"
    ],
    "category": "Utility",
    "shortDescription": "Miyu, an AI companion that works on your computer",
    "longDescription": "Miyu: a tray icon that starts and stops Miyu and opens the Miyu web interface in your browser. Includes the Miyu core and web app.",
    "license": "AGPL-3.0-or-later",
    "homepage": "https://github.com/miyu-agent/miyu-applet",
    "externalBin": [
      "dist/binaries/miyu",
      "dist/binaries/miyu-sandbox",
      "dist/binaries/miyu-extract"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libgtk-3-0"
        ],
        "files": {
          "/usr/share/miyu": "dist/resources"
        },
        "desktopTemplate": "packaging/linux/miyu-applet.desktop"
      },
      "rpm": {
        "depends": [
          "gtk3"
        ],
        "files": {
          "/usr/share/miyu": "dist/resources"
        },
        "desktopTemplate": "packaging/linux/miyu-applet.desktop"
      }
    }
  },
  "productName": "miyu-applet"
}
